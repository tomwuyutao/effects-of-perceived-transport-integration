. preserve
{txt}
{com}. clear
{txt}
{com}. * Build a small plotting dataset from the regression output so the x-axis respects the missing reference period.
. set obs 9
{txt}{p}
Number of observations ({bf:_N}) was 0,
now 9.
{p_end}

{com}. gen event_time = .
{txt}(9 missing values generated)

{com}. gen beta = .
{txt}(9 missing values generated)

{com}. gen se = .
{txt}(9 missing values generated)

{com}. 
. replace event_time = -5 in 1
{txt}(1 real change made)

{com}. replace beta = `b_pre5' in 1
{txt}(1 real change made)

{com}. replace se = `se_pre5' in 1
{txt}(1 real change made)

{com}. 
. replace event_time = -4 in 2
{txt}(1 real change made)

{com}. replace beta = `b_pre4' in 2
{txt}(1 real change made)

{com}. replace se = `se_pre4' in 2
{txt}(1 real change made)

