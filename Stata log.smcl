. * ============================================================================
. * ROBUSTNESS: Alternative Operator Controls
. * ============================================================================
. * Table 4, columns (1) and (2): operator-control robustness using SWR and Southeastern.
. 
. foreach op in swr southeastern {c -(}
{txt}  2{com}.     quietly {c -(}
{txt}  3{com}.         use "`temp_dir'/temp_treatment.dta", clear
{txt}  4{com}.         append using "`temp_dir'/temp_control_`op'.dta"
{txt}  5{com}.         egen house_id = group(postcode PAON SAON)
{txt}  6{com}.         prep_long, idvars(house_id treated postcode PAON SAON local_authority nearest_station oa21cd dist_to_treated)
{txt}  7{com}.         bysort postcode: gen pc_count = _N
{txt}  8{com}.         keep if pc_count >= 2
{txt}  9{com}.         drop pc_count
{txt} 10{com}.         egen postcode_id  = group(postcode)
{txt} 11{com}.         egen station_id = group(nearest_station)
{txt} 12{com}.     {c )-}
{txt} 13{com}. 
.     reghdfe log_price treated_post additional_dwellings ///
>         i.property_type_enc i.built_form_enc TOTAL_FLOOR_AREA ///
>         NUMBER_HABITABLE_ROOMS i.construction_age_enc i.tenure_enc ///
>         EXTENSION_COUNT i.month i.year, ///
>         absorb(postcode_id station_id) vce(cluster postcode_id)
{txt} 14{com}.     estimates store control_`op'
{txt} 15{com}. {c )-}
