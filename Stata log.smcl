 {txt}opened on:  {res} 3 May 2026, 11:54:28

{com}. do "/Users/wyt/Documents/EC331 Code/Analysis.do"
{txt}
{com}. clear
{txt}
{com}. 
. local temp_dir "temp"
{txt}
{com}. capture mkdir "`temp_dir'"
{txt}
{com}. 
. capture program drop prep_long
{txt}
{com}. program define prep_long
{txt}  1{com}.     syntax, idvars(string) [post_year(integer 2021)]
{txt}  2{com}. 
.     * Convert the wide monthly price columns exported from Python into a transaction-month panel.
.     reshape long price_, i(`idvars') j(year_month) string
{txt}  3{com}.     rename price_ price
{txt}  4{com}. 
.     gen year  = real(substr(year_month, 1, 4))
{txt}  5{com}.     gen month = real(substr(year_month, 6, 2))
{txt}  6{com}. 
.     * Collapse year-specific housing-supply controls to one column aligned with each observation year.
.     gen additional_dwellings = .
{txt}  7{com}.     forvalues y = 2016/2025 {c -(}
{txt}  8{com}.         capture replace additional_dwellings = additional_dwellings_`y' if year == `y'
{txt}  9{com}.     {c )-}
{txt} 10{com}.     capture drop additional_dwellings_*
{txt} 11{com}. 
.     gen post         = (year >= `post_year')
{txt} 12{com}.     gen treated_post = treated * post
{txt} 13{com}. 
.     drop if missing(price)
{txt} 14{com}.     gen log_price = ln(price)
{txt} 15{com}. 
.     encode PROPERTY_TYPE,         gen(property_type_enc)
{txt} 16{com}.     encode BUILT_FORM,            gen(built_form_enc)
{txt} 17{com}.     encode CONSTRUCTION_AGE_BAND, gen(construction_age_enc)
{txt} 18{com}.     encode TENURE,                gen(tenure_enc)
{txt} 19{com}. end
{txt}
{com}. 
. * ============================================================================
. * PREPARE DATA
. * ============================================================================
. 
. quietly {c -(}
{txt}
{com}. 
. * Build base long dataset (reused by most regressions)
. quietly {c -(}
{txt}
{com}. 
. * Build a broader long dataset before postcode support filtering.
. * This feeds the OA FE and station x ring FE checks, which apply their own support rules later.
. quietly {c -(}
{txt}
{com}. 
. * Count full-sample estimation observations before any support filter is applied.
. quietly {c -(}
{txt}
{com}. 
. * ============================================================================
. * BASELINE: Treatment vs Ring (Postcode FE)
. * ============================================================================
. * Table 3. Baseline Difference-in-Differences results.
. 
. quietly {c -(}
{txt}
{com}. 
